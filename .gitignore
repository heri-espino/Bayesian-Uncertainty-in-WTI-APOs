# # Yahoo Finance market-data snapshots remain local. Version code, query metadata,
# # hashes and derived scientific summaries rather than redistributing raw Yahoo data.
# data/wti_yahoo/*.csv
# data/wti_yahoo/*.json
# data/wti_yahoo_contracts/*.csv
# data/wti_yahoo_contracts/*.json

# # Local official Treasury source CSVs. Keep the parser/docs versioned.
# data/rates/treasury/*.csv

# Other Databento raw folders remain ignored by default.
data/databento/**/raw/
# Explicitly INCLUDE reconstructed 81-month AAO DBNs in this private Git LFS repo.
!data/databento/wti_aao_bulk/raw/
data/databento/wti_aao_bulk/raw/*
!data/databento/wti_aao_bulk/raw/aao_definition__*.dbn.zst
!data/databento/wti_aao_bulk/raw/aao_statistics__*.dbn.zst
# Ignore incomplete or partially downloaded transfers.
data/databento/wti_aao_bulk/raw/*.partial.dbn.zst

# Reconstructed private SQLite and compressed candidate panels are also Git LFS.
data/databento/wti_aao_bulk/derived_private/*
!data/databento/wti_aao_bulk/derived_private/aao_cross_month_PROVISIONAL_*.sqlite3
!data/databento/wti_aao_bulk/derived_private/AAO_CANDIDATES_NOT_VALIDATED_*.csv.gz
!data/databento/wti_aao_bulk/derived_private/AAO_DATABENTO_REDUCED_FORM_CONTRACT_PRICING.csv.gz
# Never stage mutable SQLite write-ahead log / shared-memory files.
data/databento/wti_aao_bulk/derived_private/*.sqlite3-wal
data/databento/wti_aao_bulk/derived_private/*.sqlite3-shm

# # Generated experiment checkpoints and large intermediates
