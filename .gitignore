docs/_build/

# Generated JFM manuscript build/staging tree
paper/build/
paper/espino_2026_bayess-on-wti.pdf

# Yahoo Finance market-data snapshots remain local. Version code, query metadata,
# hashes and derived scientific summaries rather than redistributing raw Yahoo data.
data/wti_yahoo/*.csv
data/wti_yahoo/*.json
data/wti_yahoo_contracts/*.csv
data/wti_yahoo_contracts/*.json

# Local official Treasury source CSVs. Keep the parser/docs versioned.
data/rates/treasury/*.csv

# Generated experiment checkpoints and large intermediates
# Keep final manifests and summary CSVs; do not version thousands of restart files.
results/**/*.npz
results/**/checkpoints/
results/**/*_raw.csv
results/**/progress.json
results/**/pricing_progress.json

# Keep only the rolling workstation report in Git; timestamped snapshots remain local.
results/system/hardware_report_*.json
results/system/hardware_report_*.txt
!results/system/hardware_report_latest.json
!results/system/hardware_report_latest.txt

# Python package build products
build/
dist/

